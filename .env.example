DATABASE_URL=postgres://bricks:bricks@localhost:5432/bricks

# Production compose
POSTGRES_PASSWORD=change-me
# APP_PORT=3000
# COOKIE_SECURE=false

# Optional
# DATA_DIR=./data
# AUTO_MIGRATE=true
# Days a deleted item waits in the trash before it is deleted for good (0 = never)
# TRASH_RETENTION_DAYS=30

# End-to-end tests only
# E2E_DATABASE_URL=postgres://bricks:bricks@localhost:5432/bricks_e2e

# Rebrickable catalog import (Settings > Catalog). Never scheduled; an admin presses the button.
# true lets the import fetch the downloads page itself. Leave false (admins paste the page instead)
# until Rebrickable has said fetching it is OK.
# REBRICKABLE_PAGE_FETCH=false
# REBRICKABLE_DOWNLOADS_PAGE=https://rebrickable.com/downloads/
# Origins the import may download from (https only; e2e adds a loopback mock)
# REBRICKABLE_ALLOWED_ORIGINS=https://rebrickable.com,https://cdn.rebrickable.com
# The only origin set covers are downloaded from
# CATALOG_IMAGE_ORIGIN=https://cdn.rebrickable.com
# Optional build/release label, also sent in the import User-Agent
# APP_VERSION=
