# Copy this to .env in this folder, fill in the two required values, then: docker compose up -d
# The compose file builds DATABASE_URL from POSTGRES_PASSWORD, always sets COOKIE_SECURE=true
# (the app is served over HTTPS by the Tailscale sidecar) and keeps DATA_DIR at /data.

# Required
POSTGRES_PASSWORD=change-me
TS_AUTHKEY=tskey-auth-change-me

# Optional. A commented-out line keeps the app's default, shown here.
# Days a deleted item waits in the trash before it is deleted for good (0 = never)
# TRASH_RETENTION_DAYS=30
# Instruction PDFs: the largest file the app will store, in MB
# INSTRUCTIONS_MAX_MB=200
# false skips database migrations on start
# AUTO_MIGRATE=true
# Release label sent in the catalog import User-Agent (the published image sets it to its commit)
# APP_VERSION=

# Rebrickable catalog import (Settings > Catalog). Never scheduled; an admin presses the button.
# Leave false (admins paste the page instead) until Rebrickable has said fetching it is OK.
# REBRICKABLE_PAGE_FETCH=false
# REBRICKABLE_DOWNLOADS_PAGE=https://rebrickable.com/downloads/
# Origins the import may download from (https only)
# REBRICKABLE_ALLOWED_ORIGINS=https://rebrickable.com,https://cdn.rebrickable.com
# The only origin set covers are downloaded from
# CATALOG_IMAGE_ORIGIN=https://cdn.rebrickable.com
